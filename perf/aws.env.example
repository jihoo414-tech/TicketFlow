# 저장소 루트에 .env.aws로 복사해 채운다. .env.aws는 커밋하지 않는다.
# python perf/run.py ladder --seats 500 --target aws

# 앱 (EC2에서 perf 프로파일로 실행 중인 컨테이너)
AWS_APP_URL=http://<EC2 퍼블릭 IP>:8080
AWS_APP_CONTAINER=ticketflow-app

# SSH (RDS 터널, 앱 재시작, 접근 로그)
AWS_EC2_HOST=<EC2 퍼블릭 IP>
AWS_EC2_USER=ec2-user
AWS_SSH_KEY=C:/Users/<you>/.ssh/<key>.pem

# k6 (앱과 같은 서브넷의 EC2에서 실행한다. 비워 두면 이 PC에서 실행한다)
AWS_K6_HOST=<k6 EC2 퍼블릭 IP>
AWS_K6_APP_URL=http://<앱 EC2 사설 IP>:8080

# 앱 컨테이너의 JWT_SECRET과 같은 값. k6가 회원 토큰을 서명한다
AWS_JWT_SECRET=<32바이트 이상 무작위 문자열>

# RDS (SSH 터널로만 접속한다)
AWS_DB_HOST=<RDS 엔드포인트>
AWS_DB_PORT=3306
AWS_DB_NAME=ticketflowwithai
AWS_DB_USER=<RDS 마스터 사용자>
AWS_DB_PASSWORD=<RDS 마스터 비밀번호>
AWS_TUNNEL_PORT=13306

# CloudWatch (CPU 크레딧, RDS CPU). 비워 두면 수집하지 않는다.
AWS_REGION=ap-northeast-2
AWS_PROFILE=
AWS_EC2_INSTANCE_ID=
AWS_RDS_INSTANCE_ID=
