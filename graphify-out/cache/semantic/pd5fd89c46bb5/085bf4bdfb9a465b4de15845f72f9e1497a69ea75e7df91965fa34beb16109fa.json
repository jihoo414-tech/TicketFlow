{"nodes": [{"id": "docs_adr_0008_serialize_seat_occupancy_with_row_locks_row_lock_serialization", "label": "ADR 0008: Serialize Seat Occupancy with Row Locks (member -> seat, id asc, READ COMMITTED)", "file_type": "rationale", "source_file": "docs/adr/0008-serialize-seat-occupancy-with-row-locks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hold is an INSERT, so there is no seat state to conditionally UPDATE/version; seat rows always exist so first-hold and expired-hold cases queue on the same row. Ascending id order prevents deadlock; READ COMMITTED ensures post-lock reads see latest commits. UNIQUE on hold_seat.seat_id, optimistic locks, and expiry scheduler rejected."}], "edges": [{"source": "docs_adr_0008_serialize_seat_occupancy_with_row_locks_row_lock_serialization", "target": "docs_concurrency_cases_pessimistic_lock", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-serialize-seat-occupancy-with-row-locks.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_serialize_seat_occupancy_with_row_locks_row_lock_serialization", "target": "docs_invariants_inv10_payment_before_expiry", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-serialize-seat-occupancy-with-row-locks.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_serialize_seat_occupancy_with_row_locks_row_lock_serialization", "target": "docs_invariants_inv6_one_hold_per_showtime", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0008-serialize-seat-occupancy-with-row-locks.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0008_serialize_seat_occupancy_with_row_locks_row_lock_serialization", "target": "docs_invariants_inv7_four_seat_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0